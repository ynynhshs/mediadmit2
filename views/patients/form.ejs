<%- include('../partials/top') %>
<%
  // Field value: from the submitted form (after an error), else from the patient being edited
  const P = patient || {};
  const get = (path) => path.split('.').reduce((o, k) => (o == null ? undefined : o[k]), P);
  const v = (name, path) => {
    if (form[name] !== undefined) return form[name];
    const x = get(path || name);
    return x == null ? '' : x;
  };
  const vd = (name, path) => form[name] !== undefined ? form[name] : fmt.inputDate(get(path || name));
  const sel = (name, path, val) => String(v(name, path)) === String(val) ? 'selected' : '';
  const isEdit = !!patient;
  const smoker = form.smoker !== undefined ? form.smoker === 'yes' : !!(P.medical && P.medical.smoker);
%>
<form method="post" action="<%= isEdit ? `/patients/${patient._id}/edit` : '/patients/register' %>" style="display:flex;flex-direction:column;gap:18px">
<div class="head">
  <div><div class="crumb"><%= isEdit ? 'Patients › Edit Record' : 'Registration › New Patient' %></div>
    <h1><%= isEdit ? 'Edit Patient Record' : 'Register New Patient' %></h1></div>
  <div class="pidbox"><%= isEdit ? 'Patient ID' : 'Patient ID' %><b><%= isEdit ? patient.patientId : 'Auto-generated on save' %></b></div>
</div>

<% if (error) { %><div class="flash err"><%= error %></div><% } %>

<div class="steps">
  <div class="st"><i>1</i>Personal Info</div><div class="line"></div>
  <div class="st"><i>2</i>Contact &amp; Emergency</div><div class="line"></div>
  <div class="st"><i>3</i>Medical History</div><div class="line"></div>
  <div class="st"><i>4</i>Insurance</div>
</div>

<div class="card" data-stepper <%= isEdit ? 'data-edit' : '' %> style="padding:24px 28px">
  <!-- STEP 1 -->
  <div class="step">
    <div class="sec">Personal Information</div>
    <div class="grid4">
      <div class="f"><label>First Name <em>*</em></label><input name="firstName" value="<%= v('firstName') %>" required></div>
      <div class="f"><label>Middle Name</label><input name="middleName" value="<%= v('middleName') %>"></div>
      <div class="f s2"><label>Last Name <em>*</em></label><input name="lastName" value="<%= v('lastName') %>" required></div>
      <div class="f"><label>Birthdate <em>*</em></label><input type="date" name="birthDate" value="<%= vd('birthDate') %>" max="<%= fmt.inputDate(new Date()) %>" required></div>
      <div class="f"><label>Sex <em>*</em></label>
        <select name="sex" required><option value="">Select</option><option <%= sel('sex','sex','Male') %>>Male</option><option <%= sel('sex','sex','Female') %>>Female</option></select></div>
      <div class="f"><label>Civil Status</label>
        <select name="civilStatus"><% ['Single','Married','Widowed','Separated'].forEach(c => { %><option <%= sel('civilStatus','civilStatus',c) %>><%= c %></option><% }) %></select></div>
    </div>
  </div>

  <!-- STEP 2 -->
  <div class="step">
    <div class="sec">Contact Details</div>
    <div class="grid4">
      <div class="f s2"><label>Street Address</label><input name="address" value="<%= v('address') %>"></div>
      <div class="f"><label>City / Municipality</label><input name="city" value="<%= v('city') %>"></div>
      <div class="f"><label>Mobile No. <em>*</em></label><input name="contactNo" value="<%= v('contactNo') %>" placeholder="09XX XXX XXXX" required></div>
      <div class="f s2"><label>Email</label><input type="email" name="email" value="<%= v('email') %>"></div>
    </div>
    <div class="sec">Emergency Contact</div>
    <div class="grid4">
      <div class="f s2"><label>Full Name <em>*</em></label><input name="ecName" value="<%= v('ecName','emergencyContact.name') %>" required></div>
      <div class="f"><label>Relationship <em>*</em></label><input name="ecRelationship" value="<%= v('ecRelationship','emergencyContact.relationship') %>" required></div>
      <div class="f"><label>Mobile No. <em>*</em></label><input name="ecContactNo" value="<%= v('ecContactNo','emergencyContact.contactNo') %>" required></div>
    </div>
  </div>

  <!-- STEP 3 -->
  <div class="step">
    <div class="sec">Medical History</div>
    <div class="grid4">
      <div class="f"><label>Blood Type</label>
        <select name="bloodType"><option value="">Unknown</option><% ['A+','A-','B+','B-','AB+','AB-','O+','O-'].forEach(b => { %><option <%= sel('bloodType','medical.bloodType',b) %>><%= b %></option><% }) %></select></div>
      <div class="f"><label>Height (cm)</label><input type="number" name="heightCm" min="20" max="250" value="<%= v('heightCm','medical.heightCm') %>"></div>
      <div class="f"><label>Weight (kg)</label><input type="number" name="weightKg" min="1" max="400" step="0.1" value="<%= v('weightKg','medical.weightKg') %>"></div>
      <div class="f"><label>Smoker</label>
        <div class="radio"><label><input type="radio" name="smoker" value="yes" <%= smoker ? 'checked' : '' %>><span>Yes</span></label><label><input type="radio" name="smoker" value="no" <%= smoker ? '' : 'checked' %>><span>No</span></label></div></div>
      <div class="f s2"><label>Known Allergies <span class="sub">(separate with commas)</span></label><input name="allergies" value="<%= v('allergies','medical.allergies') %>" placeholder="e.g. Penicillin, Seafood"></div>
      <div class="f s2"><label>Existing Conditions</label><input name="conditions" value="<%= v('conditions','medical.conditions') %>"></div>
      <div class="f s2"><label>Current Medications</label><input name="medications" value="<%= v('medications','medical.medications') %>"></div>
      <div class="f s2"><label>Past Surgeries</label><input name="surgeries" value="<%= v('surgeries','medical.surgeries') %>"></div>
    </div>
  </div>

  <!-- STEP 4 -->
  <div class="step">
    <div class="sec">Insurance Details</div>
    <div class="grid4">
      <div class="f"><label>Insurance Provider</label>
        <select name="provider"><% ['PhilHealth','Maxicare','Intellicare','Medicard','None'].forEach(i => { %><option <%= sel('provider','insurance.provider',i) %>><%= i %></option><% }) %></select></div>
      <div class="f"><label>Member / PIN No.</label><input name="memberNo" value="<%= v('memberNo','insurance.memberNo') %>"></div>
      <div class="f"><label>HMO (optional)</label><input name="hmo" value="<%= v('hmo','insurance.hmo') %>"></div>
      <div class="f"><label>Coverage Valid Until</label><input type="date" name="validUntil" value="<%= vd('validUntil','insurance.validUntil') %>"></div>
    </div>
    <div class="info">Check the details before saving. <%= isEdit ? 'Changes will be recorded in the Audit Trail.' : 'A unique Patient ID will be created automatically when you save.' %></div>
  </div>

  <div style="display:flex;justify-content:space-between;align-items:center;margin-top:24px">
    <button type="button" class="btn ghost" id="backBtn">← Back</button>
    <button type="button" class="btn pri" id="nextBtn">Continue →</button>
    <div id="finishBtns" style="gap:12px">
      <% if (isEdit) { %>
        <a class="btn ghost" href="/patients?id=<%= patient._id %>">Cancel</a>
        <button class="btn pri" type="submit">Save Changes</button>
      <% } else { %>
        <button class="btn ghost" type="submit" name="next" value="profile">Save Patient</button>
        <% if (can('assessPatients')) { %><button class="btn pri" type="submit" name="next" value="assess">Save &amp; Assess →</button>
        <% } else if (can('admitDischarge')) { %><button class="btn pri" type="submit" name="next" value="admit">Save &amp; Admit →</button><% } %>
      <% } %>
    </div>
  </div>
</div>
</form>
<%- include('../partials/bottom') %>
