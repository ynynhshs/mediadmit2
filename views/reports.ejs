<%- include('partials/top') %>
<%
  const COLORS = ['#ef4444', '#f59e0b', '#22c55e'];
  let acc = 0;
  const stops = triage.map((w, i) => { const a = acc; acc += w.count / (assessTotal || 1) * 100; return `${COLORS[i]} ${a}% ${acc}%`; });
  const ICON = { registrations: ['#eef0ff','#4f46e5','user'], patients: ['#e0f2fe','#0284c7','doc'], assessments: ['#fee2e2','#dc2626','pulse'], admissions: ['#dcfce7','#16a34a','plus'] };
  const DESC = { registrations: 'New patients registered, with demographics', patients: 'Master list of patient information and insurance', assessments: 'Vital signs, triage level and recommendation', admissions: 'Admissions by physician, reason and status' };
%>
<div class="head">
  <div><div class="crumb">Reports Generation</div><h1>Reports</h1></div>
  <form class="acts" method="get" id="rangeForm">
    <input type="hidden" name="type" value="<%= type %>">
    <input class="input" type="date" name="from" value="<%= from %>"> <span class="sub">to</span>
    <input class="input" type="date" name="to" value="<%= to %>">
    <button class="btn ghost" type="submit">Apply</button>
    <button class="btn pri" type="button" id="printBtn">⎙ Print / Save as PDF</button>
  </form>
</div>

<div class="printhead">
  <h2>MediAdmit — <%= TYPES[type] %></h2>
  <div class="sub">Period: <%= from %> to <%= to %> · Generated <%= fmt.fullDateTime(new Date()) %> by <%= currentUser.firstName %> <%= currentUser.lastName %></div>
</div>

<div class="row noprint">
  <% Object.keys(TYPES).forEach(k => { %>
    <a class="card rc <%= type === k ? 'on' : '' %>" href="/reports?type=<%= k %>&from=<%= from %>&to=<%= to %>"><%- fmt.icon(...ICON[k]) %><div><b><%= TYPES[k] %></b><p><%= DESC[k] %></p></div></a>
  <% }) %>
</div>

<div class="row">
  <div class="card" style="flex:1.3">
    <h3><%= type === 'registrations' || type === 'patients' ? 'Monthly Registrations' : type === 'assessments' ? 'Monthly Assessments' : 'Monthly Admissions' %> <small>Last 6 months</small></h3>
    <div class="chart" style="height:260px">
      <% months.forEach(m => { %>
        <div class="c"><b style="color:#1d2140;font-size:12px"><%= m.count %></b><div class="one" <%- fmt.style(`height:${m.count / maxMonth * 80}%`) %>></div><%= m.label %></div>
      <% }) %>
    </div>
  </div>
  <div class="card" style="flex:1">
    <h3>Assessments by Triage Level <span class="sub">Selected period</span></h3>
    <div style="display:flex;gap:22px;align-items:center">
      <div class="don" <%- fmt.style(`background:${assessTotal ? `conic-gradient(${stops.join(',')})` : '#eef0f7'}`) %>><div><span><b><%= assessTotal %></b>assessments</span></div></div>
      <div class="dl">
        <% triage.forEach((w, i) => { %><div><span><i <%- fmt.style(`background:${COLORS[i]}`) %>></i><%= w._id %></span><b><%= w.count %></b></div><% }) %>
        <div class="sub" style="margin-top:6px"><%= rangeTotal %> admission<%= rangeTotal === 1 ? '' : 's' %> in this period</div>
      </div>
    </div>
    <div style="margin-top:20px" class="tablewrap"><table>
      <tr><th>Top Admitting Physician</th><th>Admissions</th><th>Share</th></tr>
      <% topPhysicians.forEach(p => { %><tr><td><%= p._id %></td><td><%= p.count %></td><td><%= rangeTotal ? Math.round(p.count / rangeTotal * 100) : 0 %>%</td></tr><% }) %>
    </table></div>
  </div>
</div>

<div class="card">
  <h3><%= TYPES[type] %> <span class="sub"><%= rows.length %> row(s)</span></h3>
  <div class="tablewrap tall"><table>
    <tr><% columns.forEach(c => { %><th><%= c %></th><% }) %></tr>
    <% rows.forEach(r => { %><tr><% r.forEach((cell, i) => { %><td class="<%= i === 0 ? 'mono' : '' %>"><%= cell %></td><% }) %></tr><% }) %>
  </table></div>
  <% if (!rows.length) { %><div class="empty">No records for this period.</div><% } %>
</div>

<script>
  document.getElementById('printBtn').addEventListener('click', async () => {
    // Record the export in the Audit Trail, then open the browser's print window
    try {
      await fetch('/reports/log', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: '<%= type %>', from: '<%= from %>', to: '<%= to %>' }) });
    } catch (e) {}
    window.print();
  });
</script>
<%- include('partials/bottom') %>
